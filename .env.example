# --- Translation provider -------------------------------------------------
# "claude" (default) or "deepl"
TRANSLATOR=claude

# Used when TRANSLATOR=claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Model for translation. Haiku is fast + cheap and fine for this.
# Check current model names at https://docs.claude.com — update if needed.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Used when TRANSLATOR=deepl (free tier: https://www.deepl.com/pro-api)
DEEPL_API_KEY=
