# Public site URL for Open Graph / share links
NEXT_PUBLIC_SITE_URL=https://cha-dictionary.vercel.app

# --- Optional: AI fallback for strings CC-CEDICT cannot cover -----------
# CC-CEDICT handles headwords and short glosses. Long definitions and
# examples need a fallback translator — set one of these if you want them
# translated too. Leave unset to use CC-CEDICT only (no API key needed).
#
# TRANSLATOR_FALLBACK=claude
# TRANSLATOR_FALLBACK=deepl

# Used when TRANSLATOR_FALLBACK=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Used when TRANSLATOR_FALLBACK=deepl
DEEPL_API_KEY=
