{
  "name": "cha-dictionary",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "download-words": "node scripts/download-words.mjs",
    "copy-public-data": "node scripts/copy-public-data.mjs",
    "prebuild": "node -e \"const fs=require('fs'); if(!fs.existsSync('data/words.txt')||!fs.existsSync('data/frequency.txt')||!fs.existsSync('data/cedict.txt')||!fs.existsSync('data/cefr-levels.json')||!fs.existsSync('data/c1c2-words.json')) require('child_process').execSync('node scripts/download-words.mjs',{stdio:'inherit'})\" && node scripts/copy-public-data.mjs"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.454.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0"
  }
}
